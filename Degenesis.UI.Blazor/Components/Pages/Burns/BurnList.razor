@page "/dashboard/burns"
@using Degenesis.Shared.DTOs.Burns

@if (Burns is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ShowCreateDialog()">Create New Burn</MudButton>

    <MudTable Bordered 
        Items="@Burns" 
        Hover="true" 
        Filter="FilterFunc" 
        Dense="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Burns</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="SearchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel 
                    InitialDirection="SortDirection.Ascending" 
                    SortBy="@((BurnDto x) => x.Name)">
                Name
                </MudTableSortLabel>
            </MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Chakra</MudTh>
            <MudTh>Earth Chakra</MudTh>
            <MudTh>Effect</MudTh>
            <MudTh>Weak Cost</MudTh>
            <MudTh>Potent Cost</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Chakra">@context.Chakra</MudTd>
            <MudTd DataLabel="Earth Chakra">@context.EarthChakra</MudTd>
            <MudTd DataLabel="Effect">@context.Effect</MudTd>
            <MudTd DataLabel="Weak Cost">@context.WeakCost</MudTd>
            <MudTd DataLabel="Potent Cost">@context.PotentCost</MudTd>
            <MudTd>
                <MudButton Color="Color.Primary" OnClick="() => ShowEditDialog(context.Id)">Edit</MudButton>
                <MudButton Color="Color.Error" OnClick="() => DeleteBurn(context.Id)">Delete</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}