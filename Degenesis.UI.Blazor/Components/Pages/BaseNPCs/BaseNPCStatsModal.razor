<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2"><b>@NPC.Name</b></MudText>

        <MudStack Wrap="Wrap.Wrap" Row AlignItems="AlignItems.Center" Justify="@Justify.SpaceAround">
            @{
                int rowMaxElement = 3;
                int rowElementNb = 0;
            }
            @foreach (var attr in NPC.Attributes)
            {
                <MudPaper Class="pa-1" Width="32%" Outlined="true">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">@attr.AttributeName</MudText>
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                            <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                           Disabled="@(attr.Level <= 0)"
                                           OnClick="() => ChangeAttributeLevel(attr, -1)"
                                           Size="Size.Small"
                                           Color="Color.Primary" />

                            <MudRating SelectedValue="@attr.Level"
                                       MaxValue="6"
                                       ReadOnly="true"
                                       FullIcon="@Icons.Material.Filled.Square"
                                       EmptyIcon="@Icons.Material.Outlined.Square"
                                       FullIconColor="Color.Primary"
                                       EmptyIconColor="Color.Primary"
                                       Size="Size.Small" />

                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Disabled="@(attr.Level >= 6)"
                                           OnClick="() => ChangeAttributeLevel(attr, 1)"
                                           Size="Size.Small"
                                           Color="Color.Success" />
                        </MudStack>
                    </MudStack>

                    <MudDivider />

                    @foreach (var skill in NPC.Skills.Where(s => s.AttributeId == attr.AttributeId))
                    {
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">@skill.SkillName</MudText>
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                               Disabled="@(skill.Level <= 0)"
                                               OnClick="() => ChangeSkillLevel(skill, -1)"
                                               Size="Size.Small"
                                               Color="Color.Primary" />
                                <MudRating SelectedValue="@skill.Level"
                                           MaxValue="6"
                                           ReadOnly="true"
                                           FullIcon="@Icons.Material.Filled.Square"
                                           EmptyIcon="@Icons.Material.Outlined.Square"
                                           FullIconColor="Color.Primary"
                                           EmptyIconColor="Color.Primary"
                                           Size="Size.Small" />

                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                               Disabled="@(skill.Level >= 6)"
                                               OnClick="() => ChangeSkillLevel(skill, 1)"
                                               Size="Size.Small"
                                               Color="Color.Success" />
                            </MudStack>
                        </MudStack>
                    }
                </MudPaper>
                rowElementNb++;
                if (rowElementNb == rowMaxElement)
                {
                    <MudFlexBreak />
                    rowElementNb = 0;
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Save" Color="Color.Primary">Save</MudButton>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Cancel</MudButton>
    </DialogActions>
</MudDialog>