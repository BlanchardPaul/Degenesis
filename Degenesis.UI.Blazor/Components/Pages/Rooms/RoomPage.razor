@page "/room/{IdRoom:guid}"
@using Degenesis.Shared.DTOs.Characters.Display

@if (room is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudTabs Class="d-flex flex-column" Style="height: 100%;">
        <MudTabPanel Text="Map and Chat">
            <RoomMapChat IdRoom="IdRoom" />
        </MudTabPanel>

        @if (IsGM)
        {
            <MudTabPanel Text="Characters">
                <MudList T="string" Class="mt-2">
                    @foreach (var c in gmCharacters)
                    {
                        <MudListItem T="string">
                            <div class="d-flex flex-column">
                                <span>@c.Name <i class="ml-1">(@c.PlayerName)</i></span>
                                <MudStack Row="true" Spacing="1" Class="mt-1">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               Href="@GetGmCharacterUrl(c.Id, "sheet")"
                                               Target="_blank">Details</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               Href="@GetGmCharacterUrl(c.Id, "inventory")"
                                               Target="_blank">Inventory</MudButton>
                                </MudStack>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudTabPanel>
        }
        else
        {
            <MudTabPanel Text="Character">
                <RoomCharacterSheet Character="Character"
                                    OnRequestParentReload="ReloadCharacter" />
            </MudTabPanel>
            <MudTabPanel Text="Inventory">
                <RoomCharacterInventory Character="Character"
                                        OnRequestParentReload="ReloadCharacter" />
            </MudTabPanel>
        }
    </MudTabs>

    <MudFab Style="position: fixed; top: 70px; right: 15px; z-index: 10;"
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Casino"
            Size="Size.Large"
            OnClick="OpenDiceRollModal" />
}