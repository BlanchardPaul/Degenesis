@page "/room/{IdRoom:guid}"
@using Degenesis.Shared.DTOs.Characters.Display
@using Degenesis.UI.Blazor.Components.Pages.Rooms.Character
@using Degenesis.UI.Blazor.Components.Pages.Rooms.CharacterInventory
@using Degenesis.UI.Blazor.Components.Pages.Rooms.MapChatArea
@using Degenesis.UI.Blazor.Components.Pages.Rooms.NPC

@if (room is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudTabs Class="d-flex flex-column" Style="height: 100%;">
        <MudTabPanel Text="Map and Chat">
            <RoomMapChat IdRoom="IdRoom" Character="Character"/>
        </MudTabPanel>

        @if (IsGM)
        {
            <MudTabPanel Text="Characters">
               <RoomGmCharacterList GmCharacters="GmCharacters" />
            </MudTabPanel>
            <MudTabPanel Text="NPCs">
                <RoomGmNpcList GmNpcs="GmNpcs"
                               IdRoom="IdRoom"
                               OnRequestParentReload="LoadGmNpcs" />
            </MudTabPanel>
        }
        else
        {
            <MudTabPanel Text="Character">
                <RoomCharacterSheet Character="Character"/>
            </MudTabPanel>
            <MudTabPanel Text="Inventory">
                <RoomCharacterInventory Character="Character"
                                        OnRequestParentReload="ReloadCharacter" />
            </MudTabPanel>
        }
        <MudTabPanel Text="Cults">
            <RoomCultRelationshipPage IdRoom="IdRoom" IsGM=IsGM/>
        </MudTabPanel>
    </MudTabs>

    <MudFab Style="position: fixed; top: 70px; right: 15px; z-index: 10;"
            Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.Casino"
            Size="Size.Large"
            OnClick="OpenDiceRollModal" />

    @if (_showDiceRollModal && (Character is not null || IsGM))
    {
        <DiceRollModal Character="Character"
                       HubConnection="hubConnection"
                       IdRoom="IdRoom"
                       IsGM="IsGM"
                       GmCharacters="GmCharacters"
                       GmNpcs="GmNpcs"
                       OnClose="CloseDiceRollModal" />
    }
}