@using Degenesis.Shared.DTOs
@using Degenesis.Shared.DTOs.Rooms

@if (CultRelationships is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else if (CultRelationships.Count == 0)
{
    <MudAlert Severity="Severity.Info">No cults linked to this room yet.</MudAlert>
}
else
{
    <div class="cult-grid">
        @foreach (var cult in CultRelationships)
        {
            <div class="cult-card">
                @if (cult.CultImageName is not null)
                {
                    <img src="@($"{ApiRoot}/cult-images/{cult.CultImageName}")"
                         alt="@cult.CultName"
                         class="@(cult.IsDiscovered ? "cult-image" : "cult-image cult-image-undiscovered")" />
                }
                else
                {
                    <div class="cult-image cult-image-placeholder d-flex align-center justify-center">
                        <MudIcon Icon="@Icons.Material.Filled.BrokenImage" Size="Size.Large" />
                    </div>
                }

                <div class="d-flex justify-center align-center mt-1">
                    <MudText Typo="Typo.caption" Class="mr-1">
                        Relationship:
                    </MudText>

                    @if (cult.IsDiscovered && IsGM)
                    {
                        <div style="max-width:45px">
                            <MudNumericField T="int"
                                             HideSpinButtons
                                             Min="-6"
                                             Max="6"
                                             @bind-Value="cult.Relationship"
                                             Immediate="true"
                                             OnBlur="() => UpdateRelationshipAsync(cult)" />
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="@GetRelationshipStyle(cult.Relationship)">
                            <b>@FormatRelationship(cult.Relationship)</b>
                        </MudText>

                        @if (!cult.IsDiscovered && IsGM)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Class="ml-2"
                                       OnClick="() => DiscoverCult(cult)">
                                Discover cult
                            </MudButton>
                        }
                    }
                </div>
            </div>
        }
    </div>
}