<MudDialog>
    <DialogContent>
        <MudStack Row Justify="Justify.SpaceAround">
            <MudSelect T="RollType" Label="Roll type" @bind-Value="_rollType" Class="mb-4">
                <MudSelectItem T="RollType" Value="RollType.Action">Action Roll</MudSelectItem>
                <MudSelectItem T="RollType" Value="RollType.Free">Free Roll</MudSelectItem>
            </MudSelect>
            <MudSwitch @bind-Value="PrivateRoll" Label="Private roll" Color="Color.Error" />
        </MudStack>

        @if (_rollType == RollType.Free)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudNumericField @bind-Value="_diceCount" Label="Number of dice" Min="1"/>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="int" Label="Dice type" @bind-Value="_diceType">
                        <MudSelectItem T="int" Value="4">d4</MudSelectItem>
                        <MudSelectItem T="int" Value="6">d6</MudSelectItem>
                        <MudSelectItem T="int" Value="8">d8</MudSelectItem>
                        <MudSelectItem T="int" Value="10">d10</MudSelectItem>
                        <MudSelectItem T="int" Value="12">d12</MudSelectItem>
                        <MudSelectItem T="int" Value="20">d20</MudSelectItem>
                        <MudSelectItem T="int" Value="100">d100</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudNumericField @bind-Value="_modifier" Label="Modifier" />
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Attribute" @bind-Value="_selectedAttributeId"
                               ToStringFunc="@(id => id is null ? "" : Character?.Attributes.FirstOrDefault(a => a.AttributeId == id)?.Name ?? "")">
                        @foreach (var attr in Character?.Attributes ?? [])
                        {
                            <MudSelectItem T="Guid?" Value="@attr.AttributeId">@attr.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" Label="Skill" @bind-Value="_selectedSkillId"
                               ToStringFunc="@(id => id is null ? "" : Character?.Skills.FirstOrDefault(s => s.SkillId == id)?.Name ?? "")">
                        @if (_selectedAttributeId.HasValue)
                        {
                            @foreach (var skill in SkillsOfSelectedAttribute)
                            {
                                <MudSelectItem T="Guid?" Value="@skill.SkillId">@skill.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField @bind-Value="_bonus" Label="Bonus (+ dice)" Min="0"/>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField @bind-Value="_malus" Label="Malus (- dice)" Min="0" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-end">
                    <MudText Typo="Typo.subtitle2" Class="pb-2 w-100" Align="Align.Center">
                        Dice: <b>@(ActionRollDiceCount)</b> d6
                        @if (_autoSuccesses > 0)
                        {
                            <text> + <b>@(_autoSuccesses)</b> auto successes</text>
                        }
                        <br />
                        <i>(@(SelectedAttribute?.Level ?? 0) + @(SelectedSkill?.Level ?? 0) + @_bonus - @_malus)</i>
                    </MudText>
                </MudItem>
            </MudGrid>
        }

        @if (_lastRolls.Any())
        {
            <MudDivider Class="my-3" />

            @if (_rollType == RollType.Action)
            {
                <MudText Typo="Typo.subtitle1" Class="d-flex flex-wrap" Style="gap: 4px; font-size: 2rem; align-items: center;">
                    @foreach (var die in _lastRolls)
                    {
                        <span style="color: @GetDieColor(die);"
                              title="@die">@GetDieFace(die)</span>
                    }
                </MudText>
                <MudText Typo="Typo.h6" Class="mt-1">
                    <span style="color: darkred;">@_botches</span> |
                    <span style="color: red;">@_failures</span> |
                    <span style="color: green;">@_successes</span> |
                    <span style="color: goldenrod;">@_triggers</span>
                    @if (_autoSuccesses > 0)
                    {
                        <text> | <span style="color: teal;"> @_autoSuccesses auto</span></text>
                    }
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.subtitle1">Rolls: @string.Join(", ", _lastRolls)</MudText>
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-2">
                    Total: <b>@(_lastRolls.Sum() + _modifier)</b>
                </MudText>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="RollAsync" Disabled="@_isRolling">Roll</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel">Close</MudButton>
    </DialogActions>
</MudDialog>