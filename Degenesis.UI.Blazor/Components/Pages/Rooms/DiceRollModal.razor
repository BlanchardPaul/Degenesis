@using Degenesis.Shared.DTOs.Rooms
@using Degenesis.Shared.DTOs.Characters.Display
@using Degenesis.Shared.DTOs.NPCs
@inject IJSRuntime JS

<div id="dice-roll-window" class="floating-window" style="top: 100px; left: 100px;">
    <div class="floating-window-header">
        <span>Dice Roll</span>
        <span class="floating-window-close" @onclick="Cancel">✕</span>
    </div>

    <div class="floating-window-content">
        <!-- GM Mode: Character/NPC Selector -->
        @if (IsGM)
        {
            <MudAutocomplete T="Guid?" 
                             Label="Character / NPC"
                             ValueChanged="@HandleCharacterSelected"
                             SearchFunc="@SearchCharacters"
                             ToStringFunc="@(id => GetCharacterName(id))"
                             Clearable="true"
                             Dense
                             Class="mb-2" />
        }

        <MudStack Row Justify="Justify.SpaceBetween" Class="mb-3">
            <MudSelect T="RollType" @bind-Value="_rollType" Class="flex-grow-1 mr-2" Dense>
                <MudSelectItem T="RollType" Value="RollType.Action">Action</MudSelectItem>
                <MudSelectItem T="RollType" Value="RollType.Free">Free</MudSelectItem>
            </MudSelect>
            <MudSwitch @bind-Value="PrivateRoll" Label="Private" Color="Color.Error" Class="ml-2" />
        </MudStack>

        @if (_rollType == RollType.Free)
        {
            <MudNumericField @bind-Value="_diceCount" Label="# Dice" Min="1" Dense Class="mb-2" />
            <MudSelect T="int" Label="Type" @bind-Value="_diceType" Dense Class="mb-2">
                <MudSelectItem T="int" Value="4">d4</MudSelectItem>
                <MudSelectItem T="int" Value="6">d6</MudSelectItem>
                <MudSelectItem T="int" Value="8">d8</MudSelectItem>
                <MudSelectItem T="int" Value="10">d10</MudSelectItem>
                <MudSelectItem T="int" Value="12">d12</MudSelectItem>
                <MudSelectItem T="int" Value="20">d20</MudSelectItem>
                <MudSelectItem T="int" Value="100">d100</MudSelectItem>
            </MudSelect>
            <MudNumericField @bind-Value="_modifier" Label="Modifier" Dense Class="mb-2" />
        }
        else
        {
            @if (_selectedCharacterData is not null)
            {
                <MudSelect T="Guid?" Label="Attribute" @bind-Value="_selectedAttributeId" Dense Class="mb-2"
                           ToStringFunc="@(id => id is null ? "" : AvailableAttributes.FirstOrDefault(a => a.AttributeId == id)?.Name ?? "")">
                    @foreach (var attr in AvailableAttributes)
                    {
                        <MudSelectItem T="Guid?" Value="@attr.AttributeId">@attr.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="Guid?" Label="Skill" @bind-Value="_selectedSkillId" Dense Class="mb-2"
                           ToStringFunc="@(id => id is null ? "" : SkillsOfSelectedAttribute.FirstOrDefault(s => s.SkillId == id)?.Name ?? "")">
                    @if (_selectedAttributeId.HasValue)
                    {
                        @foreach (var skill in SkillsOfSelectedAttribute)
                        {
                            <MudSelectItem T="Guid?" Value="@skill.SkillId">@skill.Name</MudSelectItem>
                        }
                    }
                </MudSelect>

                <MudStack Row Spacing="1" Class="mb-2">
                    <MudNumericField @bind-Value="_bonus" Label="Bonus" Min="0" Dense Class="flex-grow-1" />
                    <MudNumericField @bind-Value="_malus" Label="Malus" Min="0" Dense Class="flex-grow-1" />
                </MudStack>

                @if (!IsGM && _selectedAttributeId.HasValue && _selectedSkillId.HasValue)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="OpenSaveRollModal"
                               Class="mb-2">
                        Save roll
                    </MudButton>
                }

                <MudText Typo="Typo.caption" Align="Align.Center" Class="mb-2">
                    Dice: <b>@(ActionRollDiceCount)</b> d6
                    @if (_autoSuccesses > 0)
                    {
                        <text> + <b>@(_autoSuccesses)</b> auto</text>
                    }
                </MudText>
            }
            else if (IsGM)
            {
                <MudAlert Severity="Severity.Info" Dense="true">Select a character or NPC first</MudAlert>
            }
        }

        @if (_lastRolls.Any())
        {
            <MudDivider Class="my-2" />

            @if (_rollType == RollType.Action)
            {
                <MudText Typo="Typo.subtitle2" Class="d-flex flex-wrap" Style="gap: 4px; font-size: 1.5rem; align-items: center; margin: 8px 0;">
                    @foreach (var die in _lastRolls)
                    {
                        <span style="color: @GetDieColor(die);" title="@die">@GetDieFace(die)</span>
                    }
                </MudText>
                <MudText Typo="Typo.caption" Class="mt-1">
                    <span style="color: darkred;">@_botches</span> |
                    <span style="color: red;">@_failures</span> |
                    <span style="color: green;">@_successes</span> |
                    <span style="color: goldenrod;">@_triggers</span>
                    @if (_autoSuccesses > 0)
                    {
                        <text> | <span style="color: teal;">+@_autoSuccesses</span></text>
                    }
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mb-1">Rolls: @string.Join(", ", _lastRolls)</MudText>
                <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-1">
                    Total: <b>@(_lastRolls.Sum() + _modifier)</b>
                </MudText>
            }
        }

        <MudStack Row Class="mt-3" Justify="Justify.FlexEnd" Spacing="1">
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="RollAsync" Disabled="@(_isRolling || (_rollType == RollType.Action && _selectedCharacterData is null))" Size="Size.Small">Roll</MudButton>
            <MudButton Color="Color.Secondary" OnClick="Cancel" Size="Size.Small">Close</MudButton>
        </MudStack>
    </div>
</div>