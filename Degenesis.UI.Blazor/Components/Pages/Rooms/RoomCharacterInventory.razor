@using Degenesis.UI.Blazor.Components.Pages.Rooms.CharacterInventory.Popovers
@if (Character is null)
{
    <MudText Color="Color.Primary">Loading Character data.</MudText>
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    // Artifacts
    <MudPaper Outlined Class="d-flex flex-column pa-4 mb-4">
        <MudStack Row=true Justify="Justify.FlexStart">
            <MudText Typo="Typo.h6">Artifacts</MudText>
            <MudButton OnClick="() => ExpandedArtifact = !ExpandedArtifact">@(ExpandedArtifact ? "Collapse" : "Expand")</MudButton>
        </MudStack>
        <MudCollapse Expanded="ExpandedArtifact">
            <MudStack>
                @if (!Character.Artifacts.Any())
                {
                    <MudText Class="mb-3">None</MudText>
                }
                else
                {
                    <MudTable Dense="true"Bordered Items="Character.Artifacts" Hover="true" Class="mb-3">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Remaining Charges</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">@context.Artifact.Name</MudTd>
                            <MudTd DataLabel="Description">@context.Artifact.Description</MudTd>
                            <MudTd DataLabel="Remaining Charges">
                                <MudNumericField HideSpinButtons @bind-Value="@context.ChargeInMagazine"
                                                 Immediate="true"
                                                 TextUpdateSuppression="false"
                                                 OnBlur="() => UpdateCharacterArtifact(context)" />
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteCharacterArtifact(context.Id)" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
            <MudStack>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Error" OnClick="OpenAddCharacterArtifactDialog" Class="align-self-start">Add</MudButton>
            </MudStack>
        </MudCollapse>
    </MudPaper>

    // Burn
    <MudPaper Outlined Class="d-flex flex-column pa-4 mb-4">
        <MudStack Row=true Justify="Justify.FlexStart">
            <MudText Typo="Typo.h6">Burn</MudText>
            <MudButton OnClick="() => ExpandedBurn = !ExpandedBurn">@(ExpandedBurn ? "Collapse" : "Expand")</MudButton>
        </MudStack>
        <MudCollapse Expanded="ExpandedBurn">
            <MudStack>
                @if (!Character.Burns.Any())
                {
                    <MudText Class="mb-3">None</MudText>
                }
                else
                {
                    <MudTable Dense="true"Bordered Items="@Character.Burns" Hover="true" LoadingProgressColor="Color.Info" Class="mb-3">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Effect</MudTh>
                            <MudTh>Weak Qty</MudTh>
                            <MudTh>Potent Qty</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">@context.Burn.Name</MudTd>
                            <MudTd DataLabel="Effect">@context.Burn.Effect</MudTd>
                            <MudTd DataLabel="Weak Qty">
                                <MudNumericField HideSpinButtons @bind-Value="@context.WeakQuantity"
                                                 Immediate="true"
                                                 TextUpdateSuppression="false"
                                                 OnBlur="() => UpdateCharacterBurn(context)" />
                            </MudTd>
                            <MudTd DataLabel="Potent Qty">
                                <MudNumericField HideSpinButtons @bind-Value="@context.PotentQuantity"
                                                 Immediate="true"
                                                 TextUpdateSuppression="false"
                                                 OnBlur="() => UpdateCharacterBurn(context)" />
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Search" Variant="Variant.Filled" Color="Color.Success" OnClick="() => OpenBurnPopover(context.Burn)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteCharacterBurn(context.Id)" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
            <MudStack>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Error" OnClick="OpenAddCharacterBurnDialog" Class="align-self-start">Add</MudButton>
            </MudStack>
        </MudCollapse>
        
        @if (SelectedBurn != null)
        {
            <BurnPopover Burn="SelectedBurn" OnClose="CloseBurnPopover" />
        }
    </MudPaper>

    // Equipments
    <MudPaper Outlined Class="d-flex flex-column pa-4 mb-4">
        <MudStack Row=true Justify="Justify.FlexStart">
            <MudText Typo="Typo.h6">Equipments</MudText>
            <MudButton OnClick="() => ExpandedEquipment = !ExpandedEquipment">@(ExpandedEquipment ? "Collapse" : "Expand")</MudButton>
        </MudStack>
        <MudCollapse Expanded="ExpandedEquipment">
            <MudStack>
                @if (!Character.Equipments.Any())
                {
                    <MudText Class="mb-3">None</MudText>
                }
                else
                {
                    <MudTable Dense="true"Bordered Items="@Character.Equipments" Hover="true" Class="mb-3">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Equipment Type</MudTh>
                            <MudTh>Effect</MudTh>
                            <MudTh>Encumbrance</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Equipment.Name</MudTd>
                            <MudTd>@context.Equipment.EquipmentType.Name</MudTd>
                            <MudTd>@(string.IsNullOrEmpty(context.Equipment.Effect) ? "-" : context.Equipment.Effect)</MudTd>
                            <MudTd>@(context.Equipment.Encumbrance == 0 ? "-" : context.Equipment.Encumbrance)</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Search" Variant="Variant.Filled" Color="Color.Success" OnClick="() => OpenEquipmentPopover(context.Equipment)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"  Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteCharacterEquipment(context.Id)" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
            <MudStack>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Error" OnClick="OpenAddCharacterEquipmentDialog" Class="align-self-start">Add</MudButton>
            </MudStack>
        </MudCollapse>
        
        @if (SelectedEquipment != null)
        {
            <EquipmentPopover Equipment="SelectedEquipment" OnClose="CloseEquipmentPopover" />
        }
    </MudPaper>

    // Protections
    <MudPaper Outlined Class="d-flex flex-column pa-4 mb-4">
        <MudStack Row=true Justify="Justify.FlexStart">
            <MudText Typo="Typo.h6">Protections</MudText>
            <MudButton OnClick="() => ExpandedProtection = !ExpandedProtection">@(ExpandedProtection ? "Collapse" : "Expand")</MudButton>
        </MudStack>
        <MudCollapse Expanded="ExpandedProtection">
            <MudStack>
                @if (!Character.Protections.Any())
                {
                    <MudText Class="mb-3">None</MudText>
                }
                else
                {
                    <MudTable Dense="true"Bordered Items="@Character.Protections" Hover="true" Class="mb-3">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Armor</MudTh>
                            <MudTh>Defense</MudTh>
                            <MudTh>Attack</MudTh>
                            <MudTh>Qualities</MudTh>
                            <MudTh>Slots</MudTh>
                            <MudTh>Encumbrance</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Protection.Name</MudTd>
                            <MudTd>@(context.Protection.Armor.HasValue? context.Protection.Armor: "-")</MudTd>
                            <MudTd>@(string.IsNullOrEmpty(context.Protection.Defense) ? "-" : context.Protection.Defense)</MudTd>
                            <MudTd>@(string.IsNullOrEmpty(context.Protection.Attack) ? "-" : context.Protection.Attack)</MudTd>

                            <MudTd>
                                <MudTextField @bind-Value="@context.Qualities"
                                              Immediate="true" TextUpdateSuppression="false"
                                              OnBlur="() => UpdateCharacterProtection(context)" />
                            </MudTd>
                            <MudTd>
                                @if (context.Slots == 0)
                                {
                                    <span> - </span>
                                }
                                else
                                {
                                    <MudStack Row="true" Justify="Justify.FlexStart" Spacing="1">
                                        <div style="width:30px">
                                            @{
                                                <MudNumericField HideSpinButtons @bind-Value="@context.UsedSlots"
                                                                    Immediate="true" TextUpdateSuppression="false"
                                                                    OnBlur="() => UpdateCharacterProtection(context)" />
                                            }
                                        </div>
                                        <span> / </span>
                                        <div style="width:30px">
                                            @{
                                                <MudNumericField HideSpinButtons @bind-Value="@context.Slots"
                                                                    Immediate="true" TextUpdateSuppression="false"
                                                                    OnBlur="() => UpdateCharacterProtection(context)" />
                                            }
                                        </div>
                                    </MudStack>
                                }
                            </MudTd>
                            <MudTd>
                                <MudNumericField HideSpinButtons @bind-Value="@context.Encumbrance"
                                                 Immediate="true" TextUpdateSuppression="false"
                                                 OnBlur="() => UpdateCharacterProtection(context)"/>
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Search" Variant="Variant.Filled" Color="Color.Success" OnClick="() => OpenProtectionPopover(context.Protection)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"  Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteCharacterProtection(context.Id)"/>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
            <MudStack>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Error" OnClick="OpenAddCharacterProtectionDialog" Class="align-self-start">Add</MudButton>
            </MudStack>
        </MudCollapse>
        @if (SelectedProtection != null)
        {
            <ProtectionPopover Protection="SelectedProtection" OnClose="CloseProtectionPopover" />
        }
    </MudPaper>

    // Vehicles
    <MudPaper Outlined Class="d-flex flex-column pa-4 mb-4">
        <MudStack Row=true Justify="Justify.FlexStart">
            <MudText Typo="Typo.h6">Vehicles</MudText>
            <MudButton OnClick="() => ExpandedVehicle = !ExpandedVehicle">@(ExpandedVehicle ? "Collapse" : "Expand")</MudButton>
        </MudStack>
        <MudCollapse Expanded="ExpandedVehicle">
            <MudStack>
                @if (!Character.Vehicles.Any())
                {
                    <MudText Class="mb-3">None</MudText>
                }
                else
                {
                    <MudTable Dense="true"Bordered Items="@Character.Vehicles" Hover="true" Class="mb-3">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Max Speed</MudTh>
                            <MudTh>Acc.</MudTh>
                            <MudTh>Brake</MudTh>
                            <MudTh>Armor</MudTh>
                            <MudTh>Qualities</MudTh>
                            <MudTh>Body|Flesh</MudTh>
                            <MudTh>Structure|Trauma</MudTh>
                            <MudTh>Slots</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Vehicle.Name</MudTd>
                            <MudTd>@context.Vehicle.MaxSpeed</MudTd>
                            <MudTd>@context.Vehicle.Acceleration</MudTd>
                            <MudTd>@context.Vehicle.Brake</MudTd>
                            <MudTd>@(context.Vehicle.Armor == 0 ? "-" : context.Vehicle.Armor)</MudTd>
                            <MudTd>
                                <MudTextField @bind-Value="@context.Qualities"
                                              Immediate="true" TextUpdateSuppression="false"
                                              OnBlur="() => UpdateCharacterVehicle(context)" />
                            </MudTd>
                            <MudTd>
                                <MudStack Row="true" Justify="Justify.FlexStart" Spacing="1">
                                    <div style="width:30px">
                                        @{
                                            <MudNumericField HideSpinButtons @bind-Value="@context.BodyFleshLost"
                                                               Immediate="true" TextUpdateSuppression="false"
                                                               OnBlur="() => UpdateCharacterVehicle(context)" />
                                        }
                                    </div>
                                    <span> / </span>
                                    <div style="width:30px">
                                        @{
                                            <MudNumericField HideSpinButtons @bind-Value="@context.BodyFlesh"
                                                               Immediate="true" TextUpdateSuppression="false"
                                                               OnBlur="() => UpdateCharacterVehicle(context)" />
                                        }
                                    </div>
                                </MudStack>
                            </MudTd>
                            <MudTd>
                                <MudStack Row="true" Justify="Justify.FlexStart" Spacing="1">
                                <div style="width:30px">
                                    @{<MudNumericField HideSpinButtons @bind-Value="@context.StructureTraumaLost"
                                                     Immediate="true" TextUpdateSuppression="false"
                                                     OnBlur="() => UpdateCharacterVehicle(context)"/>}
                                </div>
                                <span> / </span>
                                <div style="width:30px">
                                    @{<MudNumericField HideSpinButtons @bind-Value="@context.StructureTrauma"
                                                        Immediate="true" TextUpdateSuppression="false"
                                                        OnBlur="() => UpdateCharacterVehicle(context)"/>}
                                </div>
                                </MudStack>
                            </MudTd>
                            <MudTd>
                                @if(context.Slots == 0)
                                {
                                    <span> - </span>
                                }
                                else
                                {
                                    <MudStack Row="true" Justify="Justify.FlexStart" Spacing="1">
                                        <div style="width:30px">
                                            @{
                                                <MudNumericField HideSpinButtons @bind-Value="@context.UsedSlots"
                                                                 Immediate="true" TextUpdateSuppression="false"
                                                                 OnBlur="() => UpdateCharacterVehicle(context)" />
                                            }
                                        </div>
                                        <span> / </span>
                                        <div style="width:30px">
                                            @{
                                                <MudNumericField HideSpinButtons @bind-Value="@context.Slots"
                                                                 Immediate="true" TextUpdateSuppression="false"
                                                                 OnBlur="() => UpdateCharacterVehicle(context)" />
                                            }
                                        </div>
                                    </MudStack>
                                }
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Search" Variant="Variant.Filled" Color="Color.Success" OnClick="() => OpenVehiclePopover(context.Vehicle)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"  Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteCharacterVehicle(context.Id)" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
            <MudStack>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Error" OnClick="OpenAddCharacterVehicleDialog" Class="align-self-start">Add</MudButton>
            </MudStack>
        </MudCollapse>
        @if (SelectedVehicle != null)
        {
            <VehiclePopover Vehicle="SelectedVehicle" OnClose="CloseVehiclePopover" />
        }
    </MudPaper>

    // Weapons
    <MudPaper Outlined Class="d-flex flex-column pa-4 mb-4">
        <MudStack Row=true Justify="Justify.FlexStart">
            <MudText Typo="Typo.h6">Weapons</MudText>
            <MudButton OnClick="() => ExpandedWeapon = !ExpandedWeapon">@(ExpandedWeapon ? "Collapse" : "Expand")</MudButton>
        </MudStack>
        <MudCollapse Expanded="ExpandedWeapon">
            <MudStack>
                @if (!Character.Weapons.Any())
                {
                    <MudText Class="mb-3">None</MudText>
                }
                else
                {
                    <MudTable Dense="true"Bordered Items="@Character.Weapons" Hover="true" Class="mb-3">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Caliber</MudTh>
                            <MudTh>Handling</MudTh>
                            <MudTh>Distance</MudTh>
                            <MudTh>Damage</MudTh>
                            <MudTh>Qualities</MudTh>
                            <MudTh>Magazine</MudTh>
                            <MudTh>Encumbrance</MudTh>
                            <MudTh>Slots</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Weapon.Name</MudTd>
                            <MudTd>@(string.IsNullOrEmpty(context.Weapon.Caliber) ? "-" : context.Weapon.Caliber)</MudTd>
                            <MudTd>@(string.IsNullOrEmpty(context.Weapon.Handling) ? "-" : context.Weapon.Handling)</MudTd>
                            <MudTd>@(string.IsNullOrEmpty(context.Weapon.Distance) ? "-" : context.Weapon.Distance)</MudTd>
                            <MudTd>@FormatDamage(context.Weapon)</MudTd>
                            <MudTd>
                                <MudTextField @bind-Value="@context.Qualities"
                                              Immediate="true" TextUpdateSuppression="false"
                                              OnBlur="() => UpdateCharacterWeapon(context)" />
                            </MudTd>
                            <MudTd>
                                @if (context.Weapon.Magazine == 0)
                                {
                                    <span> - </span>
                                }
                                else
                                {
                                    <MudStack Row="true" Justify="Justify.FlexStart" Spacing="1">
                                        <div style="width:30px">
                                            @{
                                                <MudNumericField HideSpinButtons @bind-Value="@context.BulletsInMagazine"
                                                                 Immediate="true" TextUpdateSuppression="false"
                                                                 OnBlur="() => UpdateCharacterWeapon(context)" />
                                            }
                                        </div>
                                        <span> / </span>
                                        <div style="width:30px">@context.Weapon.Magazine</div>
                                    </MudStack>
                                }
                            </MudTd>
                            <MudTd>
                                <MudNumericField HideSpinButtons @bind-Value="@context.Encumbrance"
                                                 Immediate="true" TextUpdateSuppression="false"
                                                 OnBlur="() => UpdateCharacterWeapon(context)" />
                            </MudTd>
                            <MudTd>
                                @if (context.Slots == 0)
                                {
                                    <span> - </span>
                                }
                                else
                                {
                                    <MudStack Row="true" Justify="Justify.FlexStart" Spacing="1">
                                        <div style="width:30px">
                                            @{
                                                <MudNumericField HideSpinButtons @bind-Value="@context.UsedSlots"
                                                                 Immediate="true" TextUpdateSuppression="false"
                                                                 OnBlur="() => UpdateCharacterWeapon(context)" />
                                            }
                                        </div>
                                        <span> / </span>
                                        <div style="width:30px">
                                            @{
                                                <MudNumericField HideSpinButtons @bind-Value="@context.Slots"
                                                                 Immediate="true" TextUpdateSuppression="false"
                                                                 OnBlur="() => UpdateCharacterWeapon(context)" />
                                            }
                                        </div>
                                    </MudStack>
                                }
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Search" Variant="Variant.Filled" Color="Color.Success" OnClick="() => OpenWeaponPopover(context.Weapon)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"  Variant="Variant.Filled" Color="Color.Error" OnClick="() => DeleteCharacterWeapon(context.Id)" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
            <MudStack>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Error" Class="align-self-start" OnClick="OpenAddCharacterWeaponDialog">Add</MudButton>
            </MudStack>
        </MudCollapse>
        @if (SelectedWeapon != null)
        {
            <WeaponPopover Weapon="SelectedWeapon" OnClose="CloseWeaponPopover" />
        }
    </MudPaper>

    // Notes
    <MudPaper Outlined Class="d-flex flex-column pa-4 mb-4">
        <MudText Typo="Typo.h5">Notes</MudText>
        <MudTextField T="string" Variant="Variant.Outlined"
                      @bind-Value="Character.InventoryNotes" AutoGrow Lines="3"
                      Margin="Margin.Dense" OnBlur="UpdateCharacterInventoryNotes" Typo="Typo.h6" />
    </MudPaper>
}