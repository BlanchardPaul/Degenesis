@if (room is null)
{
    <MudProgressCircular />
}
else
{
    <MudPaper Class="pl-6 pr-4 pb-4 rounded-lg d-flex flex-column" Style="height: 85vh; margin-top : 4px !important">

        <MudGrid style="height: 100%; margin-top: 0 !important;">
            <MudItem xs="9"
                     Class="border bg-light pa-0"
                     Style="height: 100%; position: relative; overflow: hidden; padding: 0;">
                @if (IsGM)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight"
                                   Color="Color.Primary"
                                   OnClick="ToggleMembersDrawer"
                                   Style="position: absolute; top: 40%; left: 8px; z-index: 1;" />
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
                                    Color="Color.Primary"
                                    OnClick="ToggleGridDrawer"
                                    Style="position: absolute; top: 40%; right: 8px; z-index: 1;" />

                }
                @if (!IsGM)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft"
                                   Color="Color.Primary"
                                   OnClick="ToggleSavedRollsDrawer"
                                   Style="position: absolute; top: 40%; right: 8px; z-index: 1;" />
                }

                @if (SelectedMap is not null)
                {
                    <svg @ref="_mapSvg"
                         viewBox="@($"0 0 {SelectedMap.Width} {SelectedMap.Height}")"
                         preserveAspectRatio="xMidYMid meet"
                         @onpointerdown="StartMapDrag"
                         @onpointermove="DragMap"
                         @onpointerup="EndMapDrag"
                         @onpointercancel="EndMapDrag"
                         @ondragover="IgnoreMapDragOver"
                         @ondragover:preventDefault="true"
                         @ondrop="DropToken"
                         style="position: absolute; inset: 0; width: 100%; height: 100%; transform: @MapTransform; transform-origin: center; cursor: @(isMapDragging ? "grabbing" : "grab"); touch-action: none;">
                        <defs>
                            <clipPath id="mapTokenAvatarClip" clipPathUnits="objectBoundingBox">
                                <circle cx="0.5" cy="0.5" r="0.5" />
                            </clipPath>
                        </defs>
                        <image href="@GetSelectedMapImageUrl()"
                               x="0" y="0"
                               width="@SelectedMap.Width" height="@SelectedMap.Height"
                               preserveAspectRatio="xMidYMid meet"
                               draggable="false" />
                        @if (IsGM && _isGridVisible)
                        {
                            <g stroke="#263238" stroke-opacity="0.65" stroke-width="2" pointer-events="none">
                                @foreach (var column in Enumerable.Range(1, Math.Max(0, GridColumns - 1)))
                                {
                                    var x = GridCellSize * column;
                                    <line x1="@SvgNumber(x)" y1="0" x2="@SvgNumber(x)" y2="@SelectedMap.Height" />
                                }
                                @foreach (var row in Enumerable.Range(1, Math.Max(0, GridRows - 1)))
                                {
                                    var y = GridCellSize * row;
                                    <line x1="0" y1="@SvgNumber(y)" x2="@SelectedMap.Width" y2="@SvgNumber(y)" />
                                }
                            </g>
                        }
                        @foreach (var token in CurrentMapTokens)
                        {
                            <g @onpointerdown="args => StartTokenDrag(token, args)"
                               @onpointerdown:stopPropagation="true"
                               @onpointerdown:preventDefault="true"
                               @oncontextmenu="args => OpenTokenContextMenu(token, args)"
                               @oncontextmenu:preventDefault="true"
                               @oncontextmenu:stopPropagation="true"
                               style="cursor: grab;">
                                <circle cx="@SvgNumber(token.X)" cy="@SvgNumber(token.Y)" r="@SvgNumber(GridCellSize / 2)" fill="#263238" />
                                @if (token.AvatarName is not null)
                                {
                                    <image href="@GetTokenAvatarUrl(token)"
                                           x="@SvgNumber(token.X - GridCellSize / 2)" y="@SvgNumber(token.Y - GridCellSize / 2)"
                                           width="@SvgNumber(GridCellSize)" height="@SvgNumber(GridCellSize)"
                                           clip-path="url(#mapTokenAvatarClip)"
                                           draggable="false" />
                                }
                                else
                                {
                                    <foreignObject x="@SvgNumber(token.X - GridCellSize / 2)" y="@SvgNumber(token.Y - GridCellSize / 2)"
                                                   width="@SvgNumber(GridCellSize)" height="@SvgNumber(GridCellSize)">
                                        <div
                                             style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: white; font-size: @(SvgNumber(TokenLabelSize))px;">
                                            @GetInitials(token.Name)
                                        </div>
                                    </foreignObject>
                                }
                                <circle cx="@SvgNumber(token.X)" cy="@SvgNumber(token.Y)" r="@SvgNumber(GridCellSize / 2)" fill="none" stroke="white" stroke-width="3" />
                                <foreignObject x="@SvgNumber(token.X - GridCellSize * 1.5)" y="@SvgNumber(token.Y + GridCellSize / 2 + 2)"
                                               width="@SvgNumber(GridCellSize * 3)" height="@SvgNumber(GridCellSize * 0.75)">
                                    <div style="width: 100%; overflow: hidden; color: white; text-align: center; white-space: nowrap; text-overflow: ellipsis; font-size: @(SvgNumber(TokenLabelSize))px; text-shadow: -1px -1px 2px #263238, 1px 1px 2px #263238;">
                                        @token.Name
                                    </div>
                                </foreignObject>
                            </g>
                        }
                    </svg>

                    @if (IsGM && _contextMenuToken is not null)
                    {
                        <MudPaper Elevation="8"
                                  @onclick:stopPropagation="true"
                                  Style="@ContextMenuStyle">
                            <MudButton StartIcon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       FullWidth="true"
                                       OnClick="DeleteContextMenuToken">Delete</MudButton>
                        </MudPaper>
                    }

                    <MudStack Row Spacing="1"
                              Style="position: absolute; right: 12px; bottom: 12px; z-index: 1; background: rgba(255,255,255,0.8); border-radius: 8px;">
                        @if (IsGM)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Save"
                                           Color="Color.Primary"
                                           Disabled="@_isSavingMapTokens"
                                           OnClick="SaveMapTokens" />
                        }

                        <MudIconButton Icon="@Icons.Material.Filled.ZoomOut"
                                       Color="Color.Primary"
                                       Disabled="@(_mapZoom <= MinMapZoom)"
                                       OnClick="ZoomOut" />
                        <MudIconButton Icon="@Icons.Material.Filled.ZoomIn"
                                       Color="Color.Primary"
                                       Disabled="@(_mapZoom >= MaxMapZoom)"
                                       OnClick="ZoomIn" />
                    </MudStack>
                }

                <MudIconButton Icon="@(isMapsDrawerOpen ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.Map)"
                               Color="Color.Primary"
                               OnClick="ToggleMapsDrawer"
                               Style="position: absolute; top: 8px; left: 50%; transform: translateX(-50%); z-index: 1;" />

                @if (isMapsDrawerOpen)
                {
                    <RoomMapsDrawer IdRoom="IdRoom"
                                    SelectedMap="SelectedMap"
                                    OnSelect="SelectMap"
                                    OnClose="ToggleMapsDrawer" />
                }

                @if (isRollsDrawerOpen)
                {
                    <SavedRollsDrawer Character="Character"
                                      HubConnection="hubConnection"
                                      IdRoom="IdRoom"
                                      UserName="@userName"
                                      OnClose="ToggleSavedRollsDrawer" />
                }

                @if (IsGM && isGridDrawerOpen)
                {
                    <MudPaper Class="d-flex flex-column"
                              Elevation="8"
                              Style="position: absolute; top: 0; right: 0; bottom: 0; width: 320px; max-width: 100%; z-index: 2; overflow-y: auto;">
                        <div class="d-flex align-center justify-space-between pa-3">
                            <MudText Typo="Typo.subtitle1">Grid configuration</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                           Color="Color.Default"
                                           OnClick="ToggleGridDrawer" />
                        </div>
                        <MudDivider />
                        <div class="pa-3">
                            <MudCheckBox T="bool" @bind-Value="_isGridVisible" Label="Show grid" Class="mb-2" />
                            <MudText Typo="Typo.body2">Cell size: @_gridCellSize px</MudText>
                            <MudSlider T="int" @bind-Value="_gridCellSize" Min="@MinimumGridCellSize" Max="@MaximumGridCellSize" Step="1" Color="Color.Primary" Disabled="@(SelectedMap is null)" />
                            <MudStack Row Justify="Justify.SpaceBetween" Class="mb-2">
                                <MudText Typo="Typo.caption">Min: @MinimumGridCellSize px</MudText>
                                <MudText Typo="Typo.caption">Max: @MaximumGridCellSize px</MudText>
                            </MudStack>
                            <MudNumericField T="int" @bind-Value="_gridCellSize" Label="Cell size (map pixels)" Immediate="true" Class="mb-3" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Each square represents 1 m. Changing its size adjusts the number of rows and columns.</MudText>
                            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_isSavingGrid || SelectedMap is null)" OnClick="SaveGridCellSizeAsync">Save grid size</MudButton>
                        </div>
                    </MudPaper>
                }

                @if (IsGM && isMembersDrawerOpen)
                {
                    <RoomMembersDrawer GmCharacters="GmCharacters"
                                       GmNpcs="GmNpcs"
                                       OnTokenDragStart="SetPendingMapToken"
                                       OnClose="ToggleMembersDrawer" />
                }
            </MudItem>

            <MudItem xs="3" class="d-flex flex-column" Style="height: 100%; border-left: 1px solid #ccc;">
                <div class="p-2">
                    <MudText Typo="Typo.subtitle1">GM: @room.GMName</MudText>
                    <MudText Typo="Typo.subtitle2">Players: @string.Join(", ", room.Players)</MudText>
                </div>

                <MudDivider />

                <div class="flex-grow-1 d-flex flex-column-reverse overflow-auto p-2">
                    @foreach (var msg in Messages)
                    {
                        <div class="chat-bubble @(msg.Sender == userName ? "chat-bubble-end" : "chat-bubble-start")">
                            @if (msg.RollResult is not null)
                            {
                                if(msg.RollResult?.RolledForCharacterName is not null)
                                {
                                    <b>@msg.Sender rolls for @msg.RollResult.RolledForCharacterName:</b> <i>@msg.RollResult.RollDescription</i>
                                }
                                else
                                {
                                    <b>@msg.Sender rolls:</b> <i>@msg.RollResult!.RollDescription</i>
                                }
                                <div class="d-flex flex-wrap" style="gap: 4px; font-size: 1.8rem; line-height: 1;">
                                    @foreach (var die in msg.RollResult.Rolls)
                                    {
                                        <span Style="@GetDieStyle(die)" title="@die">@GetDieFace(die)</span>
                                    }
                                </div>
                                @if (msg.RollResult.IsActionRoll)
                                {
                                    <div>
                                        <span style="color: darkred;">@msg.RollResult.Botches</span> |
                                        <span style="color: red;">@msg.RollResult.Failures</span> |
                                        <span style="color: green;">@msg.RollResult.Successes</span> |
                                        <span style="color: goldenrod;">@msg.RollResult.Triggers</span>
                                        @if (msg.RollResult.AutoSuccesses > 0)
                                        {
                                            <text> | <span style="color: teal;">+@msg.RollResult.AutoSuccesses auto successes</span></text>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div>Total: <b>@msg.RollResult.Total</b></div>
                                }
                            }
                            else
                            {
                                <b>@msg.SentAtUtc | @msg.Sender:</b> @msg.Text
                            }
                        </div>
                    }
                </div>

                <div class="p-2 d-flex flex-shrink-0">
                    <MudTextField @bind-Value="currentMessage"
                                  Immediate
                                  Placeholder="Type a message..."
                                  OnKeyUp="@(async e => { if (e.Key == "Enter") await SendMessage(); })"
                                  Class="flex-grow-1" />

                    <MudButton OnClick="SendMessage"
                               Color="Color.Primary"
                               Class="ml-2">Send</MudButton>
                </div>
            </MudItem>
        </MudGrid>
    </MudPaper>
}