<MudPopover Open="true" AnchorOrigin="Origin.CenterRight" TransformOrigin="Origin.CenterRight">
    <MudPaper Class="pa-4 ma-2" Outlined>
        <MudStack>
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText HtmlTag="u" Typo="Typo.h6">@Protection.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Primary" OnClick="Close" Class="ml-auto" />
            </MudStack>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Description</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Protection.Description) ? "-" : Protection.Description)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Armor</MudText>
                <MudText Typo="Typo.body2">@(Protection.Armor == 0 ? "-" : Protection.Armor)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Defense</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Protection.Defense) ? "-" : Protection.Defense)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Attack</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Protection.Attack) ? "-" : Protection.Attack)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Qualities</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Protection.Qualities) ? "-" : Protection.Qualities)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Slots</MudText>
                <MudText Typo="Typo.body2">@(Protection.Slots == 0 ? "-" : Protection.Slots)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Encumbrance</MudText>
                <MudText Typo="Typo.body2">@(Protection.Encumbrance == 0 ? "-" : Protection.Encumbrance)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Tech Level</MudText>
                <MudText Typo="Typo.body2">@(Protection.TechLevel == 0 ? "-" : Protection.TechLevel)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Value</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Protection.Value) ? "-" : Protection.Value)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Resources</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Protection.Resources) ? "-" : Protection.Resources)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Cults</MudText>
                <MudText Typo="Typo.body2">
                    @if (Protection.Cults != null && Protection.Cults.Any())
                    {
                        @string.Join(", ", Protection.Cults.Select(bs => bs.Name))
                    }
                    else
                    {
                        <span> - </span>
                    }
                </MudText>
            </div>
        </MudStack>
    </MudPaper>
</MudPopover>