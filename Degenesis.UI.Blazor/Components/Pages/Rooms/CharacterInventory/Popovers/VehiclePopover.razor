<MudPopover Open="true" AnchorOrigin="Origin.CenterRight" TransformOrigin="Origin.CenterRight">
    <MudPaper Class="pa-4 ma-2" Outlined>
        <MudStack>
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText HtmlTag="u" Typo="Typo.h6">@Vehicle.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Primary" OnClick="Close" Class="ml-auto" />
            </MudStack>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Vehicle Type</MudText>
                <MudText Typo="Typo.body2">@Vehicle.VehicleType.Name</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Description</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Vehicle.Description) ? "-" : Vehicle.Description)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Max Speed</MudText>
                <MudText Typo="Typo.body2">@Vehicle.MaxSpeed</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Acceleration</MudText>
                <MudText Typo="Typo.body2">@Vehicle.Acceleration</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Brake</MudText>
                <MudText Typo="Typo.body2">@Vehicle.Brake</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Armor</MudText>
                <MudText Typo="Typo.body2">@(Vehicle.Armor == 0 ? "-" : Vehicle.Armor)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Body/Flesh</MudText>
                <MudText Typo="Typo.body2">@Vehicle.BodyFlesh</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Structure/Trauma</MudText>
                <MudText Typo="Typo.body2">@Vehicle.StructureTrauma</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Slots</MudText>
                <MudText Typo="Typo.body2">@(Vehicle.Slots == 0 ? "-" : Vehicle.Slots)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Tech Level</MudText>
                <MudText Typo="Typo.body2">@(Vehicle.TechLevel == 0 ? "-" : Vehicle.TechLevel)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Value</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Vehicle.Value) ? "-" : Vehicle.Value)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Resources</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Vehicle.Resources) ? "-" : Vehicle.Resources)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Cults</MudText>
                <MudText Typo="Typo.body2">@(Vehicle.Cult is null ? "-" : Vehicle.Cult.Name)</MudText>
            </div>
        </MudStack>
    </MudPaper>
</MudPopover>