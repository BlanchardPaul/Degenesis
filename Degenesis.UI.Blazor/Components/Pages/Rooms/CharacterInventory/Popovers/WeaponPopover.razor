<MudPopover Open="true" AnchorOrigin="Origin.CenterRight" TransformOrigin="Origin.CenterRight">
    <MudPaper Class="pa-4 ma-2" Outlined>
        <MudStack>
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText HtmlTag="u" Typo="Typo.h6">@Weapon.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Primary" OnClick="Close" Class="ml-auto" />
            </MudStack>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Weapon Type</MudText>
                <MudText Typo="Typo.body2">@Weapon.WeaponType.Name</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Description</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Weapon.Description) ? "-" : Weapon.Description)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Caliber</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Weapon.Caliber) ? "-" : Weapon.Caliber)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Handling</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Weapon.Handling) ? "-" : Weapon.Handling)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Distance</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Weapon.Distance) ? "-" : Weapon.Distance)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Damage</MudText>
                <MudText Typo="Typo.body2">@FormatDamage(Weapon)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Qualities</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Weapon.Qualities) ? "-" : Weapon.Qualities)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Magazine</MudText>
                <MudText Typo="Typo.body2">@(Weapon.Magazine == 0 ? "-" : Weapon.Magazine)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Encumbrance</MudText>
                <MudText Typo="Typo.body2">@(Weapon.Encumbrance == 0 ? "-" : Weapon.Encumbrance)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Slots</MudText>
                <MudText Typo="Typo.body2">@(Weapon.Slots == 0 ? "-" : Weapon.Slots)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Tech Level</MudText>
                <MudText Typo="Typo.body2">@(Weapon.TechLevel == 0 ? "-" : Weapon.TechLevel)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Value</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Weapon.Value) ? "-" : Weapon.Value)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Resources</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrEmpty(Weapon.Resources) ? "-" : Weapon.Resources)</MudText>
            </div>

            <div>
                <MudText HtmlTag="u" Typo="Typo.caption">Cults</MudText>
                <MudText Typo="Typo.body2">@(Weapon.Cults == null || !Weapon.Cults.Any() ? "-" : string.Join(", ", Weapon.Cults.Select(c => c.Name)))</MudText>
            </div>
        </MudStack>
    </MudPaper>
</MudPopover>