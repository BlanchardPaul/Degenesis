@using Degenesis.Shared.DTOs._Artifacts
<MudDialog>
    <DialogContent>
        @if (!ArtifactsLoaded)
        {
            <MudText Color="Color.Primary">Loading Artifacts.</MudText>
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        }
        else
        {
            <MudTable Bordered Items="@Artifacts" 
                      Hover="true"
                      Filter="FilterFunc"
                      Dense="true">
                <ToolBarContent>
                    <MudTextField @bind-Value="SearchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>
                        <MudTableSortLabel InitialDirection="SortDirection.Ascending"
                                           SortBy="@((ArtifactDto x) => x.Name)">
                            Name
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>Description</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => AddCharacterArtifact(context.Id)">Add to Character</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Cancel</MudButton>
    </DialogActions>
</MudDialog>