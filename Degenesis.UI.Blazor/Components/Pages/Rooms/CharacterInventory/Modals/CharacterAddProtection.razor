<MudDialog>
    <DialogContent>
        @if (!ProtectionsLoaded)
        {
            <MudText Color="Color.Primary">Loading Protections.</MudText>
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        }
        else
        {
            <MudTable Bordered Items="@Protections" Hover="true" LoadingProgressColor="Color.Info">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Armor</MudTh>
                    <MudTh>Defense</MudTh>
                    <MudTh>Attack</MudTh>
                    <MudTh>Qualities</MudTh>
                    <MudTh>Slots</MudTh>
                    <MudTh>Encumbrance</MudTh>
                    <MudTh>TechLevel</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh>Resources</MudTh>
                    <MudTh>Cults</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@context.Description</MudTd>
                    <MudTd>@(context.Armor.HasValue? context.Armor: "-")</MudTd>
                    <MudTd>@(string.IsNullOrEmpty(context.Defense) ? "-" : context.Defense)</MudTd>
                    <MudTd>@(string.IsNullOrEmpty(context.Attack) ? "-" : context.Attack)</MudTd>
                    <MudTd>@(string.IsNullOrEmpty(context.Qualities) ? "-" : context.Qualities)</MudTd>
                    <MudTd>@(context.Slots == 0 ? "-" : context.Slots)</MudTd>
                    <MudTd>@(context.Encumbrance == 0 ? "-" : context.Encumbrance)</MudTd>
                    <MudTd>@(context.TechLevel == 0 ? "-" : context.TechLevel)</MudTd>
                    <MudTd>@(string.IsNullOrEmpty(context.Value) ? "-" : context.Value)</MudTd>
                    <MudTd>@(string.IsNullOrEmpty(context.Resources) ? "-" : context.Resources)</MudTd>
                    <MudTd>
                        @if (context.Cults != null && context.Cults.Any())
                        {
                            @string.Join(", ", context.Cults.Select(bs => bs.Name))
                        }
                        else
                        {
                            <span> - </span>
                        }
                    </MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => AddCharacterProtection(context.Id)">Add to Character</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Cancel</MudButton>
    </DialogActions>
</MudDialog>