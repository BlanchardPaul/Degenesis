@page "/gm-npc/{IdNpc:guid}"
@using Degenesis.Shared.DTOs.NPCs

@if (NPC is null)
{
    <MudText Color="Color.Primary">Loading NPC data.</MudText>
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudPaper Elevation="0" Class="pa-1">
        <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
            <MudButton Variant="Variant.Text" OnClick="OpenAvatarDialog" Class="pa-0">
                <MudAvatar Size="Size.Large" Color="Color.Primary">
                    @if (NPC.AvatarName is null)
                    {
                        @NPC.Name.FirstOrDefault()
                    }
                    else
                    {
                        <MudImage Src="@NpcAvatarUrl" Alt="@($"{NPC.Name} avatar")" />
                    }
                </MudAvatar>
            </MudButton>
            <MudText Typo="Typo.h6"><b>@NPC.Name</b></MudText>
        </MudStack>

        <MudGrid Class="mb-4">
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Name" Label="Name" />
            </MudItem>
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Initiative" Label="Initiative" />
            </MudItem>
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Attack" Label="Attack" />
            </MudItem>
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Defense" Label="Defense" />
            </MudItem>
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Movement" Label="Movement" />
            </MudItem>
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Armor" Label="Armor" />
            </MudItem>
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Specialty" Label="Specialty" />
            </MudItem>
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Equipment" Label="Equipment" />
            </MudItem>
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Condition" Label="Condition" />
            </MudItem>
            <MudItem xs="12" md="6" sm="4">
                <MudTextField @bind-Value="NPC.Notes" Label="Notes" />
            </MudItem>
        </MudGrid>

        <MudStack Wrap="Wrap.Wrap" Row AlignItems="AlignItems.Center" Justify="@Justify.SpaceAround">
            @{
                int rowMaxElement = 3;
                int rowElementNb = 0;
            }
            @foreach (var attr in NPC.Attributes)
            {
                <MudPaper Class="pa-1" Width="32%" Outlined="true">
                    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h6">@attr.AttributeName</MudText>
                        <MudRating @bind-SelectedValue="@attr.Level"
                                   MaxValue="6"
                                   FullIcon="@Icons.Material.Filled.Square"
                                   EmptyIcon="@Icons.Material.Outlined.Square"
                                   FullIconColor="Color.Primary"
                                   EmptyIconColor="Color.Primary"
                                   Size="Size.Small" />
                    </MudStack>

                    <MudDivider />

                    @foreach (var skill in NPC.Skills.Where(s => s.AttributeId == attr.AttributeId))
                    {
                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h6">@skill.SkillName</MudText>
                            <MudRating @bind-SelectedValue="@skill.Level"
                                       MaxValue="6"
                                       FullIcon="@Icons.Material.Filled.Square"
                                       EmptyIcon="@Icons.Material.Outlined.Square"
                                       FullIconColor="Color.Primary"
                                       EmptyIconColor="Color.Primary"
                                       Size="Size.Small" />
                        </MudStack>
                    }
                </MudPaper>
                rowElementNb++;
                if (rowElementNb == rowMaxElement)
                {
                    <MudFlexBreak />
                    rowElementNb = 0;
                }
            }
        </MudStack>

        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4">Save</MudButton>
    </MudPaper>
}