@page "/dashboard/attributes"
@using Degenesis.Shared.DTOs.Characters.CRUD

<h3>Attributes</h3>

@if (attributes is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ShowCreateDialog()">Create New Attribute</MudButton>

    <MudTable Bordered 
        Items="@attributes"
        Hover="true"
        Filter="FilterFunc"
        Dense="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Attributes</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="SearchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel 
                    InitialDirection="SortDirection.Ascending" 
                    SortBy="new Func<AttributeDto, object>(x => x.Name)">
                    Name
                </MudTableSortLabel>
            </MudTh>
            <MudTh>Abbreviation</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Focus/Primal Oriented</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.Abbreviation</MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd>
                @(context.IsFocusOriented ? "Focus" : "Primal")
            </MudTd>
            <MudTd>
                <MudButton Color="Color.Primary" OnClick="() => ShowEditDialog(context.Id)">Edit</MudButton>
                <MudButton Color="Color.Error" OnClick="() => DeleteAttribute(context.Id)">Delete</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}