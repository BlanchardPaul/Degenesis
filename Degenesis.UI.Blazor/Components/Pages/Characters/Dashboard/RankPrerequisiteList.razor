@page "/dashboard/rankprerequisites"
@using Degenesis.Shared.DTOs.Characters.CRUD

@if (RankPrerequisites is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowCreateDialog">Create New Rank Prerequisite</MudButton>
    <MudTable Bordered 
            Items="@RankPrerequisites"
            Hover="true"
            Filter="FilterFunc"
            Dense="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Rank Prerequisites</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="SearchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<RankPrerequisiteDto, object>(x => x.AttributeRequired?.Name ?? string.Empty)">
                    Attribute
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<RankPrerequisiteDto, object>(x => x.SkillRequired?.Name ?? string.Empty)">
                    Skill
                </MudTableSortLabel>
            </MudTh>
            <MudTh>Sum</MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<RankPrerequisiteDto, object>(x => x.BackgroundRequired?.Name ?? string.Empty)">
                    Background
                </MudTableSortLabel>
            </MudTh>
            <MudTh>Background Level</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@(context.AttributeRequired?.Name ?? "-")</MudTd>
            <MudTd>@(context.SkillRequired?.Name ?? "-")</MudTd>
            <MudTd>@(context.SumRequired?.ToString() ?? "-")</MudTd>
            <MudTd>@(context.BackgroundRequired?.Name ?? "-")</MudTd>
            <MudTd>@(context.BackgroundLevelRequired?.ToString() ?? "-")</MudTd>
            <MudTd>
                <MudButton OnClick="() => ShowEditDialog(context.Id)" Color="Color.Primary">Edit</MudButton>
                <MudButton OnClick="() => DeleteRankPrerequisite(context.Id)" Color="Color.Error">Delete</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
