@page "/dashboard/concepts"
@using Degenesis.Shared.DTOs.Characters.CRUD

@if (concepts is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowCreateDialog">Create New Concept</MudButton>
    <MudTable Bordered 
        Items="@concepts" 
        Hover="true"
        Filter="FilterFunc"
        Dense="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Concepts</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="SearchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel 
                    InitialDirection="SortDirection.Ascending" 
                    SortBy="@((ConceptDto x) => x.Name)">
                    Name
                </MudTableSortLabel>
            </MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Bonus Attribute</MudTh>
            <MudTh>Bonus Skills</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Bonus Attribute">@context.BonusAttribute?.Name</MudTd>
            <MudTd DataLabel="Bonus Skills">
                @if (context.BonusSkills != null && context.BonusSkills.Any())
                {
                    @string.Join(", ", context.BonusSkills.Select(bs => bs.Name))
                }
                else
                {
                    <span>No bonus skills</span>
                }
            </MudTd>
            <MudTd>
                <MudButton Color="Color.Primary" OnClick="() => ShowEditDialog(context.Id)">Edit</MudButton>
                <MudButton Color="Color.Error" OnClick="() => DeleteConcept(context.Id)">Delete</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
