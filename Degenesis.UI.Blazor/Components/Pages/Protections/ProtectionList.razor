@page "/dashboard/protections"

<h3>Protections</h3>

@if (protections is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowCreateDialog">Create New Protection</MudButton>
    <MudTable Bordered Items="@protections" Hover="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Armor</MudTh>
            <MudTh>Defense</MudTh>
            <MudTh>Attack</MudTh>
            <MudTh>Qualities</MudTh>
            <MudTh>Slots</MudTh>
            <MudTh>Encumbrance</MudTh>
            <MudTh>TechLevel</MudTh>
            <MudTh>Value</MudTh>
            <MudTh>Resources</MudTh>
            <MudTh>Cults</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@(string.IsNullOrEmpty(context.Description) ? "-" : context.Description)</MudTd>
            <MudTd>@(context.Armor.HasValue ? context.Armor : "-")</MudTd>
            <MudTd>@(string.IsNullOrEmpty(context.Defense) ? "-" : context.Defense)</MudTd>
            <MudTd>@(string.IsNullOrEmpty(context.Attack) ? "-" : context.Attack)</MudTd>
            <MudTd>@(string.IsNullOrEmpty(context.Qualities) ? "-" : context.Qualities)</MudTd>
            <MudTd>@(context.Slots == 0 ? "-" : context.Slots)</MudTd>
            <MudTd>@(context.Encumbrance == 0 ? "-" : context.Encumbrance)</MudTd>
            <MudTd>@(context.TechLevel == 0 ? "-" : context.TechLevel)</MudTd>
            <MudTd>@(string.IsNullOrEmpty(context.Value) ? "-" : context.Value)</MudTd>
            <MudTd>@(string.IsNullOrEmpty(context.Resources) ? "-" : context.Resources)</MudTd>
            <MudTd>
                @if (context.Cults != null && context.Cults.Any())
                {
                    @string.Join(", ", context.Cults.Select(bs => bs.Name))
                }
                else
                {
                    <span> - </span>
                }
            </MudTd>
            <MudTd>
                <MudButton OnClick="() => ShowEditDialog(context.Id)" Color="Color.Primary">Edit</MudButton>
                <MudButton OnClick="() => DeleteProtection(context.Id)" Color="Color.Error">Delete</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}