@page "/dashboard/artifacts"
@using Degenesis.Shared.DTOs._Artifacts

@if (Artifacts is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => ShowCreateDialog()">Create New Artifact</MudButton>
    <MudTable Bordered 
        Items="Artifacts" 
        Hover="true" 
        Filter="FilterFunc" 
        Dense="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Artifacts</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="SearchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel 
                    InitialDirection="SortDirection.Ascending" 
                    SortBy="@((ArtifactDto x) => x.Name)">
                    Name
                    </MudTableSortLabel>
                </MudTh>
            <MudTh>Description</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd>
                <MudButton Color="Color.Primary" OnClick="() => ShowEditDialog(context.Id)">Edit</MudButton>
                <MudButton Color="Color.Error" OnClick="() => DeleteArtifact(context.Id)">Delete</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
