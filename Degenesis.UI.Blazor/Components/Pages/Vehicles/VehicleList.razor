@page "/dashboard/vehicles"

<h3>Vehicles</h3>

@if (Vehicle is null)
{
    <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
}
else
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowCreateDialog">Create New Vehicle</MudButton>
    <MudTable Bordered Items="@Vehicle" Hover="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Max Speed</MudTh>
            <MudTh>Acc.</MudTh>
            <MudTh>Brake (in rounds for boats)</MudTh>
            <MudTh>Armor</MudTh>
            <MudTh>Body/Flesh</MudTh>
            <MudTh>Structure/Trauma</MudTh>
            <MudTh>TechLevel</MudTh>
            <MudTh>Slots</MudTh>
            <MudTh>Value</MudTh>
            <MudTh>Resources</MudTh>
            <MudTh>Cult</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.VehicleType.Name</MudTd>
            <MudTd>@(string.IsNullOrEmpty(context.Description) ? "-" : context.Description)</MudTd>
            <MudTd>@context.MaxSpeed</MudTd>
            <MudTd>@context.Acceleration</MudTd>
            <MudTd>@context.Brake</MudTd>
            <MudTd>@(context.Armor == 0 ? "-" : context.Armor)</MudTd>
            <MudTd>@context.BodyFlesh</MudTd>
            <MudTd>@context.StructureTrauma</MudTd>
            <MudTd>@(context.TechLevel == 0 ? "-" : context.TechLevel)</MudTd>
            <MudTd>@(context.Slots == 0 ? "-" : context.Slots)</MudTd>
            <MudTd>@(string.IsNullOrEmpty(context.Value) ? "-" : context.Value)</MudTd>
            <MudTd>@(string.IsNullOrEmpty(context.Resources) ? "-" : context.Resources)</MudTd>
            <MudTd>@(context.Cult != null ? context.Cult.Name : "-")</MudTd>
            <MudTd>
                <MudButton OnClick="() => ShowEditDialog(context.Id)" Color="Color.Primary">Edit</MudButton>
                <MudButton OnClick="() => DeleteVehicle(context.Id)" Color="Color.Error">Delete</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}